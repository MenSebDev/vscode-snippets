{
  "version": "1.0.0",
  "name": "vscode-snippets",
  "description": "Collection of code snippets for different languages in VS Code.",
  "author": "MenSeb",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "keywords": [
    "vscode",
    "snippets",
    "code",
    "programming"
  ],
  "scripts": {
    "changeset": "changeset",
    "vscode:package": "pnpm -r --filter \"./snippets/*/*\" run --if-present vscode:package",
    "vscode:publish": "pnpm -r --filter \"./snippets/*/*\" run --if-present vscode:publish",
    "vscode:release": "pnpm run vscode:publish",
    "vscode:version": "changeset version",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vscode/vsce": "^3.9.1"
  }
}
